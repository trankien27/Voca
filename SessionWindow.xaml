<Window x:Class="Voca.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiên học Voca" Width="640" Height="580" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#F7F7FB" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Option" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#E3E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- stage header -->
        <Border Background="White" BorderBrush="#E6E3F5" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <TextBlock x:Name="CourseText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StageLearn" CornerRadius="12" Padding="10,4" Margin="0,0,6,0"><TextBlock x:Name="StageLearnText" Text="Học từ mới" FontSize="13"/></Border>
                    <Border x:Name="StageQuiz" CornerRadius="12" Padding="10,4" Margin="0,0,6,0"><TextBlock x:Name="StageQuizText" Text="Kiểm tra" FontSize="13"/></Border>
                    <Border x:Name="StageResult" CornerRadius="12" Padding="10,4"><TextBlock x:Name="StageResultText" Text="Kết quả" FontSize="13"/></Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- learn: flash cards -->
        <Grid x:Name="LearnPanel" Grid.Row="1" Margin="28,22">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="Card" Background="White" CornerRadius="18" BorderBrush="#E6E3F5" BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonUp="Card_Click" Padding="24">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="CardWord" FontFamily="Georgia" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CardPhonetic" FontSize="17" Foreground="{StaticResource Accent}" TextAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="CardPos" FontSize="13" FontStyle="Italic" Foreground="{StaticResource Muted}" TextAlignment="Center"/>
                    <TextBlock x:Name="CardMeaning" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <TextBlock x:Name="CardExample" FontSize="14" FontStyle="Italic" Foreground="{StaticResource Muted}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="440"/>
                    <TextBlock x:Name="CardHint" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,16,0,0"
                               Text="Bấm vào thẻ hoặc nhấn Space để xem nghĩa"/>
                </StackPanel>
            </Border>
            <Button Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0" Content="🔊  Nghe phát âm" Click="Speak_Click"/>
        </Grid>

        <!-- quiz -->
        <Grid x:Name="QuizPanel" Grid.Row="1" Margin="28,22" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="QuizQuestionLabel" Foreground="{StaticResource Muted}" FontSize="13"/>
                <TextBlock x:Name="QuizPrompt" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                <UniformGrid x:Name="QuizOptions" Columns="2"/>
                <DockPanel x:Name="TypePanel" Visibility="Collapsed" Margin="5,0">
                    <Button DockPanel.Dock="Right" x:Name="TypeCheckButton" Content="Kiểm tra" Click="TypeCheck_Click"
                            Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold" Padding="18,8"/>
                    <TextBox x:Name="TypeBox" FontSize="18" Padding="8,6" Margin="0,3,6,3"/>
                </DockPanel>
                <TextBlock x:Name="QuizFeedback" FontSize="14" TextWrapping="Wrap" Margin="5,12,5,0" MinHeight="40"/>
            </StackPanel>
        </Grid>

        <!-- result -->
        <Grid x:Name="ResultPanel" Grid.Row="1" Margin="28,18" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="KẾT QUẢ HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ResultScore" FontFamily="Georgia" FontSize="44" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="ResultNote" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                <Border x:Name="NextStepsPanel" Background="#F0EEFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <DockPanel>
                        <WrapPanel x:Name="NextStepsButtons" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="Hết từ của ngày này. Học tiếp luôn hay kiểm tra lại?" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </StackPanel>
            <ListBox x:Name="ResultList" Grid.Row="1" BorderBrush="#E6E3F5" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,3">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Next}" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontWeight="Bold" Width="20"/>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Word, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Meaning, Mode=OneWay}" Foreground="#667085"/>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E6E3F5" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="Trước" Click="Back_Click"/>
                    <Button x:Name="NextButton" Content="Tiếp" Click="Next_Click" Background="{StaticResource Accent}" Foreground="White"
                            FontWeight="SemiBold" Padding="20,8" MinWidth="110"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
