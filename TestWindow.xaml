<Window x:Class="Voca.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bài kiểm tra Voca" Width="680" Height="620" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F7F7FB" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Option" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#E3E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E6E3F5" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <TextBlock x:Name="HeaderRight" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="HeaderTitle" Text="Tạo bài kiểm tra" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            </DockPanel>
        </Border>

        <!-- setup -->
        <ScrollViewer x:Name="SetupPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20">
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Chọn phạm vi và dạng câu hỏi. Bài kiểm tra chỉ cho điểm, không làm thay đổi lịch ôn tập."/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Lộ trình" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="PlanBox" Grid.Column="1" DisplayMemberPath="Name" Padding="6" Margin="0,5"
                              SelectionChanged="PlanBox_SelectionChanged"/>

                    <TextBlock Grid.Row="1" Text="Phạm vi" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Từ ngày" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="FromDayBox" Width="70" Padding="6" SelectionChanged="Range_Changed"/>
                        <TextBlock Text="đến ngày" Style="{StaticResource Label}" Margin="12,0,8,0"/>
                        <ComboBox x:Name="ToDayBox" Width="70" Padding="6" SelectionChanged="Range_Changed"/>
                        <TextBlock x:Name="PoolText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Số câu" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CountBox" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Padding="6" Margin="0,5"
                              SelectionChanged="Range_Changed"/>

                    <TextBlock Grid.Row="3" Text="Dạng câu hỏi" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,9,0,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                        <CheckBox x:Name="KindWordToMeaning" IsChecked="True" Margin="0,3" Checked="Range_Changed" Unchecked="Range_Changed"
                                  Content="Trắc nghiệm từ → nghĩa (chọn 1 trong 4 nghĩa)"/>
                        <CheckBox x:Name="KindMeaningToWord" IsChecked="True" Margin="0,3" Checked="Range_Changed" Unchecked="Range_Changed"
                                  Content="Trắc nghiệm nghĩa → từ (chọn 1 trong 4 từ)"/>
                        <CheckBox x:Name="KindTyping" IsChecked="True" Margin="0,3" Checked="Range_Changed" Unchecked="Range_Changed"
                                  Content="Gõ từ khi nhìn nghĩa"/>
                        <CheckBox x:Name="KindListening" IsChecked="True" Margin="0,3" Checked="Range_Changed" Unchecked="Range_Changed"
                                  Content="Nghe phát âm rồi chọn từ"/>
                        <TextBlock x:Name="NoVoiceText" Foreground="#B54708" TextWrapping="Wrap" Margin="22,0,0,0" FontSize="12" Visibility="Collapsed"
                                   Text="Máy chưa có giọng đọc tiếng Anh nên dạng nghe đã tắt. Cài gói ngôn ngữ English kèm Speech trong Windows để dùng."/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="SetupError" Foreground="#B42318" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- question -->
        <Grid x:Name="QuestionPanel" Grid.Row="1" Margin="28,22" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="QuestionLabel" Foreground="{StaticResource Muted}" FontSize="13"/>
                <TextBlock x:Name="QuestionPrompt" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,4,0,2"/>
                <TextBlock x:Name="QuestionSub" FontSize="13" FontStyle="Italic" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                <Button x:Name="ListenButton" Content="🔊  Nghe lại" Click="Listen_Click" HorizontalAlignment="Left" Margin="0,0,0,12"
                        FontSize="15" Padding="18,10"/>
                <UniformGrid x:Name="OptionsGrid" Columns="2"/>
                <StackPanel x:Name="TypingPanel" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="HintButton" Content="Gợi ý" Click="Hint_Click"/>
                        <TextBox x:Name="TypingBox" FontSize="18" Padding="8,6" Margin="0,3,6,3"/>
                    </DockPanel>
                    <TextBlock x:Name="HintText" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Accent}" Margin="2,6,0,0"/>
                    <TextBlock x:Name="TypingNote" FontSize="12" Foreground="{StaticResource Muted}" Margin="2,10,0,0"
                               Text="Gõ xong bấm Enter hoặc “Câu tiếp”. Để trống nếu chưa nhớ — có thể quay lại sửa trước khi nộp."/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- result -->
        <Grid x:Name="ResultPanel" Grid.Row="1" Margin="28,18" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="KẾT QUẢ BÀI KIỂM TRA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ResultScore" FontFamily="Georgia" FontSize="44" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="ResultNote" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                <TextBlock x:Name="ResultKinds" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Border x:Name="MistakeOffer" Background="#FFF6ED" CornerRadius="10" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OfferTodayButton" Content="Học hôm nay" Click="OfferToday_Click" Background="#B54708" Foreground="White"/>
                            <Button x:Name="OfferTomorrowButton" Content="Để ngày mai" Click="OfferTomorrow_Click" Background="#FEDFC4" Foreground="#93370D"/>
                        </StackPanel>
                        <TextBlock x:Name="OfferText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
            <ListBox x:Name="ResultList" Grid.Row="1" BorderBrush="#E6E3F5" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,3">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontWeight="Bold" Width="20"/>
                            <StackPanel>
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Word, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Meaning, Mode=OneWay}" Foreground="#667085"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Given}" Foreground="#B42318" FontSize="12" Visibility="{Binding GivenVisibility}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E6E3F5" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RetryWrongButton" Content="Làm lại câu sai" Click="RetryWrong_Click" Visibility="Collapsed"/>
                    <Button x:Name="NewTestButton" Content="Bài mới" Click="NewTest_Click" Visibility="Collapsed"/>
                    <Button x:Name="BackButton" Content="Câu trước" Click="Back_Click" Visibility="Collapsed"/>
                    <Button x:Name="NextButton" Content="Bắt đầu" Click="Next_Click" Background="{StaticResource Accent}" Foreground="White"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
