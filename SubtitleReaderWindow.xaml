<Window x:Class="Voca.SubtitleReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voca · Đọc phụ đề" Width="880" Height="760" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#F7F7FB" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="7,2"/><Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="18,14,18,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontFamily="Georgia" FontSize="24" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,0">
                <CheckBox x:Name="MarkBox" Content="Tô màu từ" IsChecked="True" Click="Options_Click" Margin="0,0,18,0" VerticalAlignment="Center"
                          ToolTip="Tắt để đọc như văn bản thường, không có gợi ý"/>
                <CheckBox x:Name="TimeBox" Content="Mốc thời gian" Click="Options_Click" Margin="0,0,18,0" VerticalAlignment="Center"
                          ToolTip="Hiện thời điểm bắt đầu của mỗi đoạn trong video"/>
                <StackPanel x:Name="Legend" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Background="#FFF1C2" ToolTip="Bấm vào từ để lưu vào “Từ của tôi”">
                        <TextBlock Style="{StaticResource ChipText}" Foreground="#8A5300" Text="từ mới · bấm để lưu"/>
                    </Border>
                    <Border Style="{StaticResource Chip}" Background="#EEEBFF" ToolTip="Rê chuột lên từ để xem nghĩa">
                        <TextBlock Style="{StaticResource ChipText}" Foreground="#4B3CC4" Text="đang học · rê chuột xem nghĩa"/>
                    </Border>
                    <Border Style="{StaticResource Chip}" Background="#E7F7EE">
                        <TextBlock Style="{StaticResource ChipText}" Foreground="#067647" Text="đã lưu, chờ nghĩa"/>
                    </Border>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,8,0,0"
                   Text="Ctrl+F để tìm trong bài, Ctrl + lăn chuột để phóng to hoặc thu nhỏ chữ."/>
        <Border Background="White" CornerRadius="12" BorderBrush="#E6E3F5" BorderThickness="1" Padding="2">
            <FlowDocumentReader x:Name="Reader" ViewingMode="Scroll" IsPrintEnabled="False" IsTwoPageViewEnabled="False"
                                MinZoom="70" MaxZoom="220" ZoomIncrement="10"/>
        </Border>
    </DockPanel>
</Window>
