<ui:FluentWindow x:Class="Voca.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Voca"
        Title="Voca · Thư viện" Width="1040" Height="740" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FEE4E2"/><Setter Property="Foreground" Value="#B42318"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="GuideCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E6E3F5"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="GuideNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="GuideTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,2,0,4"/>
        </Style>
        <Style x:Key="GuideState" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GuideQ" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,6,0,1"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GuideA" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Tabs show a Fluent icon before the title: local:UiIcon.Symbol on the TabItem. -->
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Margin="0,0,7,0" VerticalAlignment="Center"
                                           Symbol="{Binding Path=(local:UiIcon.Symbol), RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PlanItem">
            <DockPanel Margin="2,4">
                <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,2" Background="{Binding ChipBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Chip}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ChipInk}"/>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Order}" Width="26" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
    <ui:TitleBar DockPanel.Dock="Top" Title="Voca · Thư viện">
        <ui:TitleBar.Icon><ui:ImageIcon Source="pack://application:,,,/Voca;component/app.ico"/></ui:TitleBar.Icon>
    </ui:TitleBar>
    <DockPanel Margin="16,4,16,16">
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="4,10,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">

            <!-- ================= Course ================= -->
            <TabItem Header="Khóa học" local:UiIcon.Symbol="BookOpen24" x:Name="CourseTab">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="Khóa học của tôi"/>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="App học lần lượt theo thứ tự này: học xong một ngày thì hôm sau sang ngày tiếp, hết tuần tự sang tuần sau."/>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button Content="Lên" local:UiIcon.Symbol="ArrowUp24" Click="MoveUp_Click"/>
                                <Button Content="Xuống" local:UiIcon.Symbol="ArrowDown24" Click="MoveDown_Click"/>
                                <Button Content="Bỏ khỏi khóa học" Click="RemoveFromCourse_Click"/>
                                <Button Content="Mở để sửa" local:UiIcon.Symbol="Edit24" Click="EditCourseItem_Click"/>
                                <Button Content="Tạo bài kiểm tra" local:UiIcon.Symbol="ClipboardTaskListLtr24" Click="CourseTest_Click"
                                        ToolTip="Kiểm tra lộ trình đang chọn: chọn khoảng ngày, số câu và dạng câu hỏi"/>
                                <Button Content="Xuất / chép sang máy khác…" local:UiIcon.Symbol="ArrowExportLtr24" Click="Export_Click" Style="{StaticResource Primary}"/>
                            </WrapPanel>
                            <ListBox x:Name="CourseList" ItemTemplate="{StaticResource PlanItem}" HorizontalContentAlignment="Stretch"
                                     BorderThickness="0" MouseDoubleClick="EditCourseItem_Click"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="Ngoài khóa học"/>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Lộ trình đã bỏ khỏi khóa học vẫn được giữ, từ đã học vẫn được ôn."/>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button Content="Thêm vào cuối khóa" local:UiIcon.Symbol="Add24" Click="AddToCourse_Click" Style="{StaticResource Primary}"/>
                                <Button Content="Mở để sửa" local:UiIcon.Symbol="Edit24" Click="EditOutsideItem_Click"/>
                            </WrapPanel>
                            <ListBox x:Name="OutsideList" ItemTemplate="{StaticResource PlanItem}" HorizontalContentAlignment="Stretch"
                                     BorderThickness="0" MouseDoubleClick="EditOutsideItem_Click"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= All words ================= -->
            <TabItem Header="Tất cả từ" local:UiIcon.Symbol="TextBulletListSquare24" x:Name="AllWordsTab"/>

            <!-- ================= Plan editor ================= -->
            <TabItem Header="Sửa lộ trình" local:UiIcon.Symbol="Edit24" x:Name="EditTab">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Lộ trình" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="PlanBox" Grid.Column="1" Grid.ColumnSpan="5" DisplayMemberPath="Name"
                                      SelectionChanged="PlanBox_SelectionChanged"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Xuất ra file…" local:UiIcon.Symbol="ArrowExportLtr24" Click="ExportPlan_Click"/>
                                <Button Content="Xóa lộ trình" local:UiIcon.Symbol="Delete24" Click="DeletePlan_Click" Style="{StaticResource Danger}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Tên" VerticalAlignment="Center" Margin="0,10,8,0"/>
                            <TextBox x:Name="PlanNameBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Cấp độ" VerticalAlignment="Center" Margin="12,10,8,0"/>
                            <TextBox x:Name="PlanLevelBox" Grid.Row="1" Grid.Column="3" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Mô tả" VerticalAlignment="Center" Margin="12,10,8,0"/>
                            <TextBox x:Name="PlanDescriptionBox" Grid.Row="1" Grid.Column="5" Margin="0,10,0,0"/>
                            <Button Grid.Row="1" Grid.Column="6" Content="Lưu thông tin" Click="SavePlanInfo_Click" Margin="11,13,3,3"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Padding="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBox x:Name="DayTitleBox" ToolTip="Tiêu đề (chủ đề con) của ngày đang chọn"/>
                                    <WrapPanel>
                                        <Button Content="Lưu tiêu đề" Click="SaveDayTitle_Click"/>
                                        <Button Content="Ngày mới" local:UiIcon.Symbol="Add24" Click="AddDay_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                                <ListBox x:Name="DaysList" DisplayMemberPath="Label" BorderThickness="0" SelectionChanged="DaysList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="10">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button Content="Thêm từ" local:UiIcon.Symbol="Add24" Click="AddWord_Click"/>
                                    <Button Content="Xóa từ đã chọn" local:UiIcon.Symbol="Delete24" Click="DeleteWord_Click"/>
                                    <Button Content="Học từ ngày này" local:UiIcon.Symbol="Play24" Click="StudyFromDay_Click" Style="{StaticResource Primary}"/>
                                    <Button Content="Kiểm tra ngày này" local:UiIcon.Symbol="ClipboardTaskListLtr24" Click="DayTest_Click"
                                            ToolTip="Tạo bài kiểm tra cho ngày đang chọn (đổi được khoảng ngày trước khi bắt đầu)"/>
                                    <Button Content="Tạo lại ngày này bằng prompt" local:UiIcon.Symbol="Sparkle24" Click="RegenDay_Click"/>
                                </WrapPanel>
                                <Border DockPanel.Dock="Bottom" x:Name="RegenPanel" Visibility="Collapsed" Margin="0,8,0,0"
                                        BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Padding="10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                   Text="Prompt cho ngày này đã được sao chép. Dán vào AI (Claude, ChatGPT…), rồi dán câu trả lời vào đây. Các từ hiện tại của ngày sẽ được thay thế."/>
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                            <Button Content="Thay ngày này" Click="ApplyRegen_Click" Style="{StaticResource Primary}"/>
                                            <Button Content="Sao chép lại prompt" Click="RegenDay_Click"/>
                                            <Button Content="Hủy" Click="CancelRegen_Click"/>
                                        </WrapPanel>
                                        <TextBox x:Name="RegenBox" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap" FontFamily="Consolas" Padding="6"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="WordsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended"
                                          GridLinesVisibility="Horizontal" Background="White" BorderBrush="#E5E5EF" RowHeaderWidth="0"
                                          CellEditEnding="WordsGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Từ" Binding="{Binding Text, UpdateSourceTrigger=LostFocus}" Width="1.1*"/>
                                        <DataGridTextColumn Header="Phiên âm" Binding="{Binding Phonetic, UpdateSourceTrigger=LostFocus}" Width="1.1*"/>
                                        <DataGridTextColumn Header="Loại" Binding="{Binding PartOfSpeech, UpdateSourceTrigger=LostFocus}" Width="0.5*"/>
                                        <DataGridTextColumn Header="Nghĩa" Binding="{Binding Meaning, UpdateSourceTrigger=LostFocus}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Ví dụ" Binding="{Binding Example, UpdateSourceTrigger=LostFocus}" Width="2*"/>
                                        <DataGridTextColumn Header="Dịch ví dụ" Binding="{Binding ExampleMeaning, UpdateSourceTrigger=LostFocus}" Width="2*"/>
                                        <DataGridTemplateColumn Header="Đã thuộc" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Learned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="LearnedBox_Click"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              ToolTip="Đã thuộc: không hiện trên taskbar, không vào phiên học và ôn tập"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ================= Create ================= -->
            <TabItem Header="Tạo chủ đề mới" local:UiIcon.Symbol="Sparkle24" x:Name="CreateTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Guide: what to do, where the learner is now, tips. Can be hidden (remembered). -->
                        <Border x:Name="GuidePanel" Style="{StaticResource Panel}" Margin="0,0,0,10" Background="#FBFAFF" BorderBrush="#DCD6FF">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Ẩn hướng dẫn" local:UiIcon.Symbol="EyeOff24" Click="HideGuide_Click" Padding="9,4" VerticalAlignment="Top"/>
                                    <TextBlock Style="{StaticResource H}" Text="Cách tạo một chủ đề mới" Margin="0,2,0,4"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="Không cần tài khoản hay API key: app soạn sẵn câu lệnh (prompt), bạn nhờ một AI miễn phí viết danh sách từ theo form mẫu, rồi dán câu trả lời vào đây. Chỉ mất vài phút."/>
                                <UniformGrid Columns="4">
                                    <Border x:Name="GuideCard1" Style="{StaticResource GuideCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource GuideNumber}" Text="1"/>
                                            <TextBlock Style="{StaticResource GuideTitle}" Text="Điền thông tin"/>
                                            <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                                       Text="Ở ô 1: chủ đề (bắt buộc), số ngày, số từ mỗi ngày, trình độ. Prompt ở ô 2 tự cập nhật theo."/>
                                            <TextBlock x:Name="GuideState1" Style="{StaticResource GuideState}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="GuideCard2" Style="{StaticResource GuideCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource GuideNumber}" Text="2"/>
                                            <TextBlock Style="{StaticResource GuideTitle}" Text="Sao chép prompt"/>
                                            <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                                       Text="Ở ô 2 bấm “Sao chép prompt”. Không cần sửa gì trong prompt."/>
                                            <TextBlock x:Name="GuideState2" Style="{StaticResource GuideState}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="GuideCard3" Style="{StaticResource GuideCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource GuideNumber}" Text="AI"/>
                                            <TextBlock Style="{StaticResource GuideTitle}" Text="Hỏi AI"/>
                                            <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                                       Text="Mở một AI, dán prompt (Ctrl+V) và gửi. AI dừng giữa chừng thì nhắn “tiếp tục”."/>
                                            <WrapPanel Margin="-3,4,0,0">
                                                <Button Content="Claude" Tag="https://claude.ai/new" Click="OpenAi_Click" Padding="8,3" FontSize="12"/>
                                                <Button Content="ChatGPT" Tag="https://chatgpt.com/" Click="OpenAi_Click" Padding="8,3" FontSize="12"/>
                                                <Button Content="Gemini" Tag="https://gemini.google.com/app" Click="OpenAi_Click" Padding="8,3" FontSize="12"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="GuideState3" Style="{StaticResource GuideState}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="GuideCard4" Style="{StaticResource GuideCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource GuideNumber}" Text="3"/>
                                            <TextBlock Style="{StaticResource GuideTitle}" Text="Dán và nhập"/>
                                            <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                                       Text="Copy toàn bộ câu trả lời của AI, dán vào ô 3, bấm “Xem trước” rồi “Nhập vào khóa học”."/>
                                            <TextBlock x:Name="GuideState4" Style="{StaticResource GuideState}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Expander Header="Mẹo và câu hỏi thường gặp" Margin="0,12,0,0" Foreground="{StaticResource Ink}">
                                    <StackPanel Margin="20,6,0,0">
                                        <TextBlock Style="{StaticResource GuideQ}" Text="AI trả lời bị cắt hoặc dừng giữa chừng?"/>
                                        <TextBlock Style="{StaticResource GuideA}" Text="Nhắn “tiếp tục” cho AI. Dán nối tất cả các phần vào ô 3 — lời chào, dấu ``` hay dòng trống thừa đều không sao, app tự bỏ qua."/>
                                        <TextBlock Style="{StaticResource GuideQ}" Text="Xem trước báo lỗi màu đỏ?"/>
                                        <TextBlock Style="{StaticResource GuideA}" Text="Sửa thẳng trong ô 3 (vd. thêm nghĩa còn thiếu, xóa từ trùng) rồi bấm “Xem trước” lại. Cảnh báo màu vàng (vd. một ngày thiếu vài từ) vẫn nhập được."/>
                                        <TextBlock Style="{StaticResource GuideQ}" Text="Nhập xong thì học thế nào?"/>
                                        <TextBlock Style="{StaticResource GuideA}" Text="Lộ trình được thêm vào cuối khóa học và tự đến lượt khi học xong các lộ trình trước. Muốn học ngay: tab Khóa học → “↑ Lên”, hoặc tab Sửa lộ trình → “▶ Học từ ngày này”."/>
                                        <TextBlock Style="{StaticResource GuideQ}" Text="Muốn sửa từ hay đổi cả một ngày?"/>
                                        <TextBlock Style="{StaticResource GuideA}" Text="Tab Sửa lộ trình: sửa trực tiếp trong bảng, thêm/xóa từ, hoặc “Tạo lại ngày này bằng prompt” để AI viết lại riêng ngày đó."/>
                                        <TextBlock Style="{StaticResource GuideQ}" Text="Đã có sẵn danh sách từ, không muốn dùng AI?"/>
                                        <TextBlock Style="{StaticResource GuideA}" Text="Tự soạn theo form mẫu bên dưới (hoặc “Lưu form mẫu…” ở ô 2 để có file), rồi dán vào ô 3 hoặc bấm “Mở file .md…”."/>
                                        <TextBlock Style="{StaticResource GuideQ}" Text="Chép lộ trình từ máy khác?"/>
                                        <TextBlock Style="{StaticResource GuideA}" Text="Dán văn bản đã sao chép (có thể gồm nhiều lộ trình) vào ô 3 rồi Xem trước → Nhập. Lộ trình đã có trong thư viện sẽ được bỏ qua, không bị trùng."/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Xem form mẫu (để tự soạn hoặc đối chiếu câu trả lời của AI)" Margin="0,6,0,0" Foreground="{StaticResource Ink}">
                                    <StackPanel Margin="20,6,0,0">
                                        <TextBlock Style="{StaticResource GuideA}"
                                                   Text="Mỗi ngày bắt đầu bằng “## Ngày N — tiêu đề”, sau đó là bảng 6 cột. Phiên âm đặt trong /…/, không dùng ký tự | trong ô. STT đánh liên tục qua các ngày."/>
                                        <TextBox x:Name="GuideExampleBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Padding="6"
                                                 Background="White" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ShowGuideButton" Content="Xem hướng dẫn tạo chủ đề" local:UiIcon.Symbol="QuestionCircle24" Click="ShowGuide_Click" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Visibility="Collapsed"/>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H}" Text="1 · Thông tin"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Chủ đề" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TopicBox" Grid.Column="1" TextChanged="CreateInput_Changed"
                                             ToolTip="Ví dụ: Travel, Du lịch bụi, IELTS Speaking Part 1"/>
                                    <TextBlock Grid.Column="2" Text="Số ngày" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                    <TextBox x:Name="DaysBox" Grid.Column="3" Text="7" TextChanged="CreateInput_Changed"/>
                                    <TextBlock Grid.Column="4" Text="Từ/ngày" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                    <TextBox x:Name="PerDayBox" Grid.Column="5" Text="20" TextChanged="CreateInput_Changed"/>
                                    <TextBlock Grid.Column="6" Text="Trình độ" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                    <ComboBox x:Name="LevelBox" Grid.Column="7" SelectedIndex="1" SelectionChanged="CreateInput_Changed">
                                        <ComboBoxItem Content="A2–B1"/><ComboBoxItem Content="B1–B2"/><ComboBoxItem Content="B2–C1"/><ComboBoxItem Content="A2–C1"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="Yêu cầu thêm" VerticalAlignment="Center" Margin="0,10,8,0"/>
