<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Voca</AssemblyName>
    <RootNamespace>Voca</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.20.0</Version>
    <Product>Voca</Product>
  </PropertyGroup>
  <ItemGroup>
    <!-- The video player for files Windows cannot play (mkv with 10-bit video, AC3 …) and for picking the audio track;
         libVLC itself is downloaded on first use (Services\VlcRuntime.cs). -->
    <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- Its build step would copy native libraries for every platform next to the exe; only win-x64 is embedded below. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ready-made plans imported on first run, in course order. -->
    <!-- Window title bars show the app icon (pack://application:,,,/Voca;component/app.ico). -->
    <Resource Include="app.ico" />
    <EmbeddedResource Include="Seed\*.md" LogicalName="Seed.%(Filename)%(Extension)" />
    <!-- The page served to phones by Services\PhoneAccess.cs. -->
    <EmbeddedResource Include="Phone\*" LogicalName="Phone.%(Filename)%(Extension)" />
    <!-- Whisper's native libraries travel inside Voca.exe and are unpacked on first use (Services\Transcriber.cs). -->
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime)\build\win-x64\*.dll" LogicalName="Whisper.%(Filename)%(Extension)" Visible="false" />
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
</Project>
