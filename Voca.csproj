<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Voca</AssemblyName>
    <RootNamespace>Voca</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.8.2</Version>
    <Product>Voca</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ready-made plans imported on first run, in course order. -->
    <EmbeddedResource Include="Seed\*.md" LogicalName="Seed.%(Filename)%(Extension)" />
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
</Project>
