<Window x:Class="Voca.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thống kê học tập" Width="600" Height="640" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#F7F7FB">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="BorderBrush" Value="#E9E7F5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="Thống kê học tập" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource CardLabel}" FontSize="13" Margin="0,4,0,14"/>

            <UniformGrid Columns="4" Margin="0,0,-10,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="StreakValue" Style="{StaticResource CardValue}" Foreground="#E8590C"/>
                        <TextBlock Text="ngày liên tiếp" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="BestStreakText" Style="{StaticResource CardLabel}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="MasteredValue" Style="{StaticResource CardValue}" Foreground="#067647"/>
                        <TextBlock Text="đã thuộc (ôn ≥ 21 ngày)" Style="{StaticResource CardLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="LearningValue" Style="{StaticResource CardValue}" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="đang học" Style="{StaticResource CardLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="DueValue" Style="{StaticResource CardValue}" Foreground="#B54708"/>
                        <TextBlock Text="đến hạn ôn hôm nay" Style="{StaticResource CardLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="30 ngày qua" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <ItemsControl x:Name="ActivityBars" Height="90">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="ActivityStart" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Hôm nay" Style="{StaticResource CardLabel}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Từ hay quên" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel x:Name="ForgottenList"/>
            </Border>
            <DockPanel Margin="0,12,0,0">
                <Button x:Name="ReviewPlanButton" Content="Tạo tuần ôn từ 20 từ hay quên" Click="ReviewPlan_Click"
                        Background="{StaticResource Accent}" Foreground="White"/>
                <TextBlock x:Name="ReviewPlanText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Các từ này được chép thành một lộ trình 10 từ/ngày, học ngay sau tuần hiện tại."/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
